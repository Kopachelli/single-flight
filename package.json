{
  "name": "single-flight",
  "version": "0.1.0",
  "description": "Collapse concurrent duplicate async work into one execution. In-flight dedupe plus optional result reuse window for agent runtimes, job workers, and cache stampede protection.",
  "keywords": [
    "idempotency",
    "dedupe",
    "single-flight",
    "async",
    "cache-stampede",
    "agents"
  ],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'}))\"",
    "test": "npm run build && node --test \"test/**/*.test.ts\"",
    "prepublishOnly": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kopachelli/single-flight.git"
  },
  "devDependencies": {
    "@types/node": "^24.19.4",
    "typescript": "^5.9.3"
  },
  "sideEffects": false
}
